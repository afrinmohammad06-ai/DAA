#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Enter size: ";
    cin >> n;

    int a[n];

    cout << "Enter elements:\n";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    int result = 0;

    for (int i = 0; i < n; i++)
        result = result ^ a[i];

    cout << "Single number = " << result;

    return 0;
}
