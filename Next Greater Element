#include <iostream>
#include <stack>
using namespace std;

int main() {
    int n;

    cout << "Enter size: ";
    cin >> n;

    int a[n];
    int result[n];

    cout << "Enter elements:\n";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    stack<int> s;

    for (int i = n - 1; i >= 0; i--) {

        while (!s.empty() && s.top() <= a[i])
            s.pop();

        if (s.empty())
            result[i] = -1;
        else
            result[i] = s.top();

        s.push(a[i]);
    }

    cout << "Next greater elements:\n";

    for (int i = 0; i < n; i++)
        cout << result[i] << " ";

    return 0;
}
