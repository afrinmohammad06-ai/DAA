#include <bits/stdc++.h>
#include <iostream>
#include <vector>
#include <queue>
using namespace std;

void DFS(int v, vector<int> graph[], bool visited[]) {
    visited[v] = true;
    cout << v << " ";

    for (int x : graph[v]) {
        if (!visited[x])
            DFS(x, graph, visited);
    }
}

void BFS(int start, vector<int> graph[], bool visited[]) {
    queue<int> q;
    visited[start] = true;
    q.push(start);

    while (!q.empty()) {
        int v = q.front();
        q.pop();

        cout << v << " ";

        for (int x : graph[v]) {
            if (!visited[x]) {
                visited[x] = true;
                q.push(x);
            }
        }
    }
}

int main() {
    int n, m;

    cout << "Enter vertices: ";
    cin >> n;

    cout << "Enter edges: ";
    cin >> m;

    vector<int> graph[n];

    cout << "Enter edges:";

    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;

        graph[u].push_back(v);
        graph[v].push_back(u);
    }

    bool visitedDFS[n] = {false};
    bool visitedBFS[n] = {false};

    cout << "DFS:";

    for (int i = 0; i < n; i++) {
        if (!visitedDFS[i])
            DFS(i, graph, visitedDFS);
    }

    cout << "\nBFS:";

    for (int i = 0; i < n; i++) {
        if (!visitedBFS[i])
            BFS(i, graph, visitedBFS);
    }

    return 0;
}
