#include <iostream>
using namespace std;

long long mergeAndCount(int a[], int low, int mid, int high) {
    int i = low;
    int j = mid + 1;
    int k = 0;

    long long count = 0;
    int temp[100];

    while (i <= mid && j <= high) {
        if (a[i] <= a[j]) {
            temp[k++] = a[i++];
        }
        else {
            temp[k++] = a[j++];
            count += (mid - i + 1);
        }
    }

    while (i <= mid)
        temp[k++] = a[i++];

    while (j <= high)
        temp[k++] = a[j++];

    for (i = low, k = 0; i <= high; i++, k++)
        a[i] = temp[k];

    return count;
}

long long inversionCount(int a[], int low, int high) {
    if (low >= high)
        return 0;

    int mid = (low + high) / 2;

    long long count = 0;

    count += inversionCount(a, low, mid);
    count += inversionCount(a, mid + 1, high);
    count += mergeAndCount(a, low, mid, high);

    return count;
}

int main() {
    int n;

    cout << "Enter size: ";
    cin >> n;

    int a[n];

    cout << "Enter elements:\n";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    cout << "Number of inversions = "
         << inversionCount(a, 0, n - 1);

    return 0;
}
