#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Enter size: ";
    cin >> n;

    int a[n];

    cout << "Enter elements:\n";
    for (int i = 0; i < n; i++)
        cin >> a[i];

    int minimum = a[0];
    int maximum = a[0];

    for (int i = 1; i < n; i++) {
        if (a[i] < minimum)
            minimum = a[i];

        if (a[i] > maximum)
            maximum = a[i];
    }

    cout << "Minimum = " << minimum << endl;
    cout << "Maximum = " << maximum << endl;

    return 0;
}
